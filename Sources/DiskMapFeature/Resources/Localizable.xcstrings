{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld files" : {
      "comment" : "Number of files inside a folder of the disk map.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld file"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld files"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
