              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld archivo"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld archivos"
                }
              }
            }
          }
        }
      }
    },
    "%lld files analyzed" : {
      "comment" : "Status shown while measuring. The argument is the number of files looked at so far.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld file analyzed"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld files analyzed"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld archivo analizado"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld archivos analizados"
                }
              }
            }
          }
        }
      }
    },
    "%lld small items" : {
      "comment" : "Number of items too small to show one by one in the disk map.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld small item"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld small items"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld elemento pequeño"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld elementos pequeños"
                }
              }
            }
          }
        }
      }
    },
    "Apps and tools keep settings and data in hidden items, such as keys, history or caches. Removing them could break them, so the map only shows them." : {
      "comment" : "Tooltip on a hidden item, such as ~/.ssh, that can't be selected in the disk map.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps y herramientas guardan ajustes y datos en ítems ocultos, como claves, historiales o cachés. Borrarlos podría estropearlas, así que el mapa solo los muestra."
          }
        }
      }
    },
    "Apps keep their data here. Removing it could break them, so the map only shows it." : {
      "comment" : "Tooltip on app data in Library that can't be selected in the disk map.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps guardan aquí sus datos. Borrarlos podría estropearlas, así que el mapa solo los muestra."
          }
        }
      }
    },
    "Copy Path" : {
      "comment" : "Entry of the context menu of a disk map item that copies its path to the clipboard.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiar ruta"
          }
        }
      }
    },
    "Couldn’t be read" : {
      "comment" : "Note on a folder of the disk map that CleanMac couldn't look into, such as one macOS keeps private.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer"
          }
        }
      }
    },
    "Deselect" : {
      "comment" : "Entry of the context menu of a disk map item that takes back its mark to be moved to the Trash.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anular selección"
          }
        }
      }
    },
    "Disk Map" : {
      "comment" : "Feature name in the sidebar.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa del disco"
          }
        }
      }
    },
    "Empty the Trash to free this space." : {
      "comment" : "Tooltip on the Trash, or an item in it, that can't be selected in the disk map.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacía la Papelera para liberar este espacio."
          }
        }
      }
    },
    "Enclosing Folder" : {
      "comment" : "Button that goes up one folder in the disk map.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carpeta contenedora"
          }
        }
      }
    },
    "For a complete map, give CleanMac Full Disk Access. Without it, macOS keeps some folders, such as Mail or Messages, out of the map." : {
      "comment" : "Note on the disk map intro about the Full Disk Access permission.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para un mapa completo, da a CleanMac Acceso total al disco. Sin él, macOS deja fuera del mapa algunas carpetas, como Mail o Mensajes."
          }
        }
      }
    },
    "Hidden" : {
      "comment" : "Note on a hidden item of the disk map, such as ~/.ssh, which the map only shows.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculto"
          }
        }
      }
    },
    "In the Trash" : {
      "comment" : "Note on the Trash, or an item in it, in the disk map.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la Papelera"
          }
        }
      }
    },
    "Move %lld Items to Trash (%@)" : {
      "comment" : "Button that moves the items selected in the disk map to the Trash. The arguments are the number of items and their size, such as “1.2 GB”.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Move %lld Item to Trash (%@)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Move %lld Items to Trash (%@)"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Mover %lld elemento a la Papelera (%@)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Mover %lld elementos a la Papelera (%@)"
                }
              }
            }
          }
        }
      }
    },
    "Move to Trash" : {
      "comment" : "Button that confirms moving the selected items to the Trash.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover a la Papelera"
          }
        }
      }
    },
    "Open" : {
      "comment" : "Opens a folder in the disk map. Tooltip of a button and entry of the context menu of an item.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir"
          }
        }
      }
    },
    "Open Privacy & Security" : {
      "comment" : "Button that opens the Privacy & Security pane of System Settings.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir Privacidad y seguridad"
          }
        }
      }
    },
    "Other" : {
      "comment" : "Small items of a folder, counted together in the disk map.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otros"
          }
        }
      }
    },
    "Protected" : {
      "comment" : "Note on data the disk map never removes, such as mail or keychains.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protegido"
          }
        }
      }
    },
    "Remove it with the Uninstaller" : {
      "comment" : "Note on an app in the disk map, pointing to the Uninstaller feature.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimínala con el Desinstalador"
          }
        }
      }
    },
    "Scan" : {
      "comment" : "Button that starts measuring the home folder for the disk map.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanear"
          }
        }
      }
    },
    "Scan Again" : {
      "comment" : "Button that measures the home folder again.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a escanear"
          }
        }
      }
    },
    "See which folders take up the most space, explore them and free up what you no longer need." : {
      "comment" : "Introduction of the disk map feature.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubre qué carpetas ocupan más espacio, explóralas y libera lo que ya no necesitas."
          }
        }
      }
    },
    "Select" : {
      "comment" : "Entry of the context menu of a disk map item that marks it to be moved to the Trash.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccionar"
          }
        }
      }
    },
    "Show in Finder" : {
      "comment" : "Reveals an item of the disk map in Finder. Tooltip of a button and entry of the context menu of an item.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar en Finder"
          }
        }
      }
    },
    "Some folders couldn’t be read and count as empty. Full Disk Access lets CleanMac read most of them." : {
      "comment" : "Note under the size of a folder of the disk map when some folders inside it couldn't be read.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas carpetas no se pudieron leer y cuentan como vacías. Con Acceso total al disco, CleanMac puede leer la mayoría."
          }
        }
      }
    },
    "System folder" : {
      "comment" : "Note on a standard folder, such as Documents, that the disk map won't remove.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carpeta del sistema"
          }
        }
      }
    },
    "This folder is empty" : {
      "comment" : "Shown in the disk map for a folder with nothing inside.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta carpeta está vacía"
          }
        }
      }
    },
    "This holds data that can’t be recovered once removed, such as passwords, mail, photos or iCloud files." : {
      "comment" : "Tooltip on protected data that can't be selected in the disk map.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contiene datos que no se recuperan una vez borrados, como contraseñas, correo, fotos o archivos de iCloud."
          }
        }
      }
    },
    "Unknown size" : {
      "comment" : "Size of a folder of the disk map that CleanMac couldn't look into, as VoiceOver reads it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaño desconocido"
          }
        }
      }
    },
    "Use the Uninstaller to remove this app together with the files it leaves behind." : {
      "comment" : "Tooltip on an app that can't be selected in the disk map.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el Desinstalador para eliminar esta app junto con los archivos que deja."
          }
        }
      }
    },
    "Used by apps" : {
      "comment" : "Note on app data in Library that the disk map only shows.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo usan las apps"
          }
        }
      }
    },
    "in %lld files" : {
      "comment" : "Shown after the size of the focused folder, as in “120 GB in 3,000 files”. The argument is the number of files.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "in %lld file"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "in %lld files"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "en %lld archivo"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "en %lld archivos"
                }
              }
            }
          }
        }
      }
    },
    "macOS doesn’t let CleanMac look inside this folder, so its size is unknown. With Full Disk Access, CleanMac can read most folders like this one." : {
      "comment" : "Tooltip on a folder of the disk map that CleanMac couldn't look into, such as one macOS keeps private.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no deja que CleanMac mire dentro de esta carpeta, así que no se sabe cuánto ocupa. Con Acceso total al disco, CleanMac puede leer la mayoría de carpetas como esta."
          }
        }
      }
    },
    "macOS expects this folder. You can remove what’s inside it." : {
      "comment" : "Tooltip on a standard folder that can't be selected in the disk map.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS necesita esta carpeta. Puedes borrar lo que contiene."
          }
        }
      }
    },
    "measured" : {
      "comment" : "Caption below the space measured so far, as in “120 GB measured”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "medidos"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
