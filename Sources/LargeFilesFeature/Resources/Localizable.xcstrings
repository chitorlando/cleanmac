{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ to %@" : {
      "comment" : "Size filter: files from one size up to another. The arguments are sizes, such as “50 MB” and “100 MB”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %@ a %@"
          }
        }
      }
    },
    "%lld files analyzed" : {
      "comment" : "Status shown while scanning. The argument is the number of files looked at so far.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld file analyzed"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld files analyzed"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld archivo analizado"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld archivos analizados"
                }
              }
            }
          }
        }
      }
    },
    "1 to 6 months" : {
      "comment" : "Last use filter: files last used between 1 and 6 months ago.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 1 a 6 meses"
          }
        }
      }
    },
    "6 to 12 months" : {
      "comment" : "Last use filter: files last used between 6 and 12 months ago.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 6 a 12 meses"
          }
        }
      }
    },
    "All Kinds" : {
      "comment" : "Filter option that shows files of every kind.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los tipos"
          }
        }
      }
    },
    "Any Size" : {
      "comment" : "Filter option that shows files of every size.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier tamaño"
          }
        }
      }
    },
    "Any Time" : {
      "comment" : "Filter option that shows files regardless of when they were last used.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier fecha"
          }
        }
      }
    },
    "Archives" : {
      "comment" : "File kind filter: zip, tar and other compressed files.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprimidos"
          }
        }
      }
    },
    "Audio" : {
      "comment" : "File kind filter: music, podcasts and recordings.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio"
          }
        }
      }
    },
    "Clear Filters" : {
      "comment" : "Button that removes every filter and search of the large files list.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitar filtros"
          }
        }
      }
    },
    "Disk Images" : {
      "comment" : "File kind filter: dmg and iso files.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imágenes de disco"
          }
        }
      }
    },
    "Documents" : {
      "comment" : "File kind filter: PDF, text, spreadsheets and presentations.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documentos"
          }
        }
      }
    },
    "Find the files that take up the most space and the ones you haven’t opened in a long time." : {
      "comment" : "Introduction of the large files feature.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra los archivos que más ocupan y los que no abres desde hace tiempo."
          }
        }
      }
    },
    "Images" : {
      "comment" : "File kind filter: photos and pictures.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imágenes"
          }
        }
      }
    },
    "Kind" : {
      "comment" : "Title of the file kind filters.",
