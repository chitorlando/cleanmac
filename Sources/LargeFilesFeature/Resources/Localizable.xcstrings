      "comment" : "Feature name in the sidebar.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos grandes"
          }
        }
      }
    },
    "Last Used" : {
      "comment" : "Sort option and filter title: when a file was last opened.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Último uso"
          }
        }
      }
    },
    "Less than a month" : {
      "comment" : "Last use filter: files used in the last month.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos de un mes"
          }
        }
      }
    },
    "More than %@" : {
      "comment" : "Size filter for the largest files. The argument is a size, such as “1 GB”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más de %@"
          }
        }
      }
    },
    "More than a year" : {
      "comment" : "Last use filter: files not used for over a year.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más de un año"
          }
        }
      }
    },
    "Move %lld Files to Trash (%@)" : {
      "comment" : "Button that moves the selected files to the Trash. The arguments are the number of files and their size, such as “1.2 GB”.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Move %lld File to Trash (%@)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Move %lld Files to Trash (%@)"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Mover %lld archivo a la Papelera (%@)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Mover %lld archivos a la Papelera (%@)"
                }
              }
            }
          }
        }
      }
    },
    "Move to Trash" : {
      "comment" : "Disabled button to remove files, shown while nothing is selected.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover a la Papelera"
          }
        }
      }
    },
    "Name" : {
      "comment" : "Sort option: alphabetical order.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre"
          }
        }
      }
    },
    "No Files Match the Filters" : {
      "comment" : "Title shown when the filters leave the list of large files empty.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún archivo coincide con los filtros"
          }
        }
      }
    },
    "No Large Files" : {
      "comment" : "Title shown when no large files were found.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay archivos grandes"
          }
        }
      }
    },
    "Nothing in your home folder takes up more than %@." : {
      "comment" : "Message shown when a complete scan found no large files. The argument is the smallest size looked for, such as “50 MB”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada en tu carpeta de inicio ocupa más de %@."
          }
        }
      }
    },
    "Other" : {
      "comment" : "File kind filter: files of any other kind.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otros"
          }
        }
      }
    },
    "Scan" : {
      "comment" : "Button that starts looking for large files.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanear"
          }
        }
      }
    },
    "Scan Again" : {
      "comment" : "Button that repeats the large files scan.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a escanear"
          }
        }
      }
    },
    "Search files" : {
      "comment" : "Placeholder of the search box over the list of large files.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar archivos"
          }
        }
      }
    },
    "Select All" : {
      "comment" : "Accessibility label of the checkbox that selects every visible file.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccionar todo"
          }
        }
      }
    },
    "Show in Finder" : {
      "comment" : "Tooltip of the button that reveals a file in Finder.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar en Finder"
          }
        }
      }
    },
    "Size" : {
      "comment" : "Sort option and filter title: how much space a file takes up.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaño"
          }
        }
      }
    },
    "Sort by" : {
      "comment" : "Label of the menu that orders the list of large files.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordenar por"
          }
        }
      }
    },
    "The scan was stopped before finding any large files." : {
      "comment" : "Message shown when the user stopped the scan before any large file was found.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El análisis se detuvo antes de encontrar archivos grandes."
          }
        }
      }
    },
    "The scan was stopped, so these results are incomplete." : {
      "comment" : "Warning shown above partial results after the user stopped the scan.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El análisis se detuvo: los resultados están incompletos."
          }
        }
      }
    },
    "Unknown" : {
      "comment" : "Shown instead of the last use date of a file when it isn't known.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconocido"
          }
        }
      }
    },
    "Videos" : {
      "comment" : "File kind filter.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeos"
          }
        }
      }
    },
    "found" : {
      "comment" : "Caption below the size of large files found so far, as in “1.2 GB found”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "encontrados"
          }
        }
      }
    },
    "in %lld large files. Choose the ones you no longer need." : {
      "comment" : "Shown after the total size found, as in “12 GB in 40 large files”. The argument is the number of files.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "in %lld large file. Choose the ones you no longer need."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "in %lld large files. Choose the ones you no longer need."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "en %lld archivo grande. Elige los que ya no necesitas."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "en %lld archivos grandes. Elige los que ya no necesitas."
                }
              }
            }
          }
        }
      }
