      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Midiendo…"
          }
        }
      }
    },
    "Memory" : {
      "comment" : "Title of the memory section of the monitor.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria"
          }
        }
      }
    },
