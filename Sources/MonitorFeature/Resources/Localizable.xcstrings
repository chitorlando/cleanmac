      "comment" : "Badge: memory is short and apps may slow down.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presión crítica"
          }
        }
      }
    },
    "Disk" : {
      "comment" : "Title of the disk section of the monitor.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disco"
          }
        }
      }
    },
    "High pressure" : {
      "comment" : "Badge: macOS is compressing memory and dropping caches.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presión alta"
