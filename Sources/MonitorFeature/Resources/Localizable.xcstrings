{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ available of %@" : {
      "comment" : "Free space of a volume. The arguments are sizes, such as “120 GB” and “500 GB”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ disponibles de %@"
          }
        }
      }
    },
    "%@ of %@ used" : {
      "comment" : "Memory in use out of the installed memory. The arguments are sizes, such as “9 GB” and “16 GB”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de %@ en uso"
          }
        }
      }
    },
    "App Memory" : {
      "comment" : "Memory that apps allocated.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria de apps"
          }
        }
      }
    },
    "Available" : {
      "comment" : "Memory apps can still get.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible"
          }
        }
      }
    },
    "CPU" : {
      "comment" : "Title of the processor section of the monitor.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU"
          }
        }
      }
    },
    "Compressed" : {
      "comment" : "Memory held compressed.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprimida"
          }
        }
      }
    },
