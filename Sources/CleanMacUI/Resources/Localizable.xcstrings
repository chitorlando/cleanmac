{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ freed" : {
      "comment" : "Title after a cleanup. The argument is a size, such as “1.2 GB”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ liberados"
          }
        }
      }
    },
    "%lld items couldn’t be moved" : {
      "comment" : "Title of the list of items that failed to move to the Trash.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld item couldn’t be moved"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld items couldn’t be moved"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld elemento no se pudo mover"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld elementos no se pudieron mover"
                }
              }
            }
          }
        }
      }
    },
    "%lld items moved to the Trash. Empty it to reclaim the disk space." : {
      "comment" : "Summary after a cleanup. The argument is the number of items removed.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld item moved to the Trash. Empty it to reclaim the disk space."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld items moved to the Trash. Empty it to reclaim the disk space."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld elemento movido a la Papelera. Vacíala para recuperar el espacio en disco."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld elementos movidos a la Papelera. Vacíala para recuperar el espacio en disco."
                }
              }
            }
          }
        }
      }
    },
    "Another app is using it. Quit that app and try again." : {
      "comment" : "Why an item couldn't be moved to the Trash: it's open in another app.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app lo está usando. Ciérrala y vuelve a intentarlo."
          }
        }
      }
    },
    "Applications" : {
      "comment" : "Sidebar section with features that manage apps.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicaciones"
          }
        }
      }
    },
    "Cleanup" : {
      "comment" : "Sidebar section with features that remove junk.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpieza"
