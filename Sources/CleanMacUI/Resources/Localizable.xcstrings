      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detener"
          }
        }
      }
    },
    "macOS protects this item. Move it to the Trash yourself in Finder, or give CleanMac Full Disk Access and try again." : {
      "comment" : "Why an item couldn't be moved to the Trash: macOS protects it, such as another app's container.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS protege este elemento. Muévelo tú a la Papelera desde Finder, o da a CleanMac acceso total al disco y vuelve a intentarlo."
          }
        }
      }
    }
