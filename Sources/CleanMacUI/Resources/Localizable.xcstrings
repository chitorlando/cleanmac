          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "¿Vaciar la Papelera y mover %lld elemento a ella?"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "¿Vaciar la Papelera y mover %lld elementos a ella?"
                }
              }
            }
          }
        }
      }
    },
    "Empty the Trash?" : {
      "comment" : "Title of the dialog that asks before emptying the Trash.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Vaciar la Papelera?"
          }
        }
      }
    },
    "Everything in the Trash is erased for good. You can’t undo this." : {
      "comment" : "Message of the dialog that asks before emptying the Trash, when CleanMac couldn’t measure it.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que hay en la Papelera se borra para siempre. No se puede deshacer."
          }
        }
      }
    },
    "Everything in the Trash, %@, is erased for good. You can’t undo this." : {
      "comment" : "Message of the dialog that asks before emptying the Trash. The argument is a size, such as “1.2 GB”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que hay en la Papelera, %@, se borra para siempre. No se puede deshacer."
          }
        }
      }
    },
    "Files" : {
      "comment" : "Sidebar section with features that find large or repeated files.",
      "localizations" : {
