        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaciar Papelera y mover elementos"
          }
        }
      }
    },
    "Empty the Trash and move %lld items to it?" : {
      "comment" : "Title of the dialog that asks before emptying the Trash and then moving other items to it. The argument is the number of items moved.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Empty the Trash and move %lld item to it?"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Empty the Trash and move %lld items to it?"
                }
