{
  "sourceLanguage" : "en",
  "strings" : {
    "Activity and diagnostic history kept by apps." : {
      "comment" : "Description of the user logs junk category.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historiales de actividad y diagnóstico de las apps."
          }
        }
      }
    },
    "All Clean" : {
      "comment" : "Title shown when no junk was found.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo limpio"
          }
        }
      }
    },
    "Analyzing your Mac…" : {
      "comment" : "Status shown while scanning.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizando tu Mac…"
          }
        }
      }
    },
    "Clean %@" : {
      "comment" : "Button that removes the selected junk. The argument is a size, such as “1.2 GB”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpiar %@"
          }
        }
      }
    },
    "Debug symbols for older iOS, watchOS and tvOS versions." : {
      "comment" : "Description of the device support junk category.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Símbolos de depuración de versiones antiguas de iOS, watchOS y tvOS."
          }
        }
      }
    },
    "Device Support" : {
      "comment" : "Junk category title.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soporte de dispositivos"
          }
        }
      }
    },
    "Free up space by removing caches, logs and development leftovers you no longer need." : {
      "comment" : "Introduction of the system junk feature.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera espacio eliminando cachés, registros y restos de desarrollo que ya no necesitas."
          }
        }
      }
    },
    "Hide items" : {
      "comment" : "Accessibility label of the button that collapses a category.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar elementos"
          }
        }
      }
    },
    "Intermediate build files. Xcode recreates them on the next build." : {
      "comment" : "Description of the Xcode derived data junk category.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compilaciones intermedias. Xcode las recrea en la siguiente compilación."
          }
        }
      }
    },
    "Scan" : {
      "comment" : "Button that starts looking for junk.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanear"
          }
        }
      }
    },
