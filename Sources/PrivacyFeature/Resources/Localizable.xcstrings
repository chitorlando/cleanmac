{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ cleared" : {
      "comment" : "Title after clearing browser caches. The argument is a size, such as “1.2 GB”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ liberados"
          }
        }
      }
    },
    "All Clean" : {
      "comment" : "Title shown when no browser caches were found.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo limpio"
          }
        }
      }
    },
    "Clear %@" : {
      "comment" : "Button that clears the selected browser caches. The argument is a size, such as “1.2 GB”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borrar %@"
          }
        }
      }
    },
    "Clear the caches your browsers keep of the pages you visit. History, passwords and cookies stay untouched." : {
      "comment" : "Introduction of the privacy feature.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra las cachés que tus navegadores guardan de las páginas que visitas. El historial, las contraseñas y las cookies no se tocan."
          }
        }
      }
    },
    "Hide caches" : {
      "comment" : "Accessibility label of the button that collapses a browser.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar las cachés"
          }
        }
      }
    },
    "Looking for browser caches…" : {
      "comment" : "Status shown while browser caches are measured.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscando las cachés de los navegadores…"
          }
        }
      }
    },
    "Privacy" : {
      "comment" : "Feature name in the sidebar.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacidad"
          }
        }
      }
    },
    "Quit %@" : {
      "comment" : "Button that asks the open apps that lock a browser's caches to quit.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salir de %@"
          }
        }
      }
    },
    "Quit %@ to clear these caches." : {
      "comment" : "Notice on a browser whose caches are locked while it or another edition of it is open. The argument is the open apps.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sal de %@ para borrar estas cachés."
          }
        }
      }
    },
    "Scan" : {
      "comment" : "Button that starts looking for browser caches.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanear"
          }
        }
      }
    },
    "Scan Again" : {
      "comment" : "Button that repeats the browser caches scan.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a escanear"
          }
        }
      }
    },
    "Service worker data that websites and web apps stored to work offline. Not selected by default: clearing it can make them start over." : {
      "comment" : "Note under a browser's service worker folder, which is listed but not selected by default.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos de service workers que los sitios y las apps web guardaron para funcionar sin conexión. No se marcan solos: borrarlos puede hacer que empiecen de cero."
          }
        }
      }
    },
    "Show caches" : {
      "comment" : "Accessibility label of the button that expands a browser.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar las cachés"
          }
        }
      }
    },
    "The caches are in the Trash. Your browsers rebuild them when they need them." : {
      "comment" : "Shown after clearing browser caches.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cachés están en la Papelera. Tus navegadores las vuelven a crear cuando las necesitan."
          }
        }
      }
    },
    "We didn’t find any browser caches to clear." : {
      "comment" : "Message shown when no browser caches were found.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hemos encontrado cachés de navegadores que borrar."
          }
        }
      }
    },
    "of browser caches found. Review what you want to clear." : {
      "comment" : "Shown below the total size of browser caches found, as in “1.2 GB of browser caches found”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "de cachés de navegadores encontrados. Revisa lo que quieres borrar."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
