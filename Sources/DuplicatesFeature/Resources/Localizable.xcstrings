              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld copias de %@ cada una"
                }
              }
            }
          }
        }
      }
    },
    "%lld groups of duplicates found" : {
      "comment" : "Status shown while scanning. The argument is the number of groups of identical files found so far.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld group of duplicates found"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld groups of duplicates found"
                }
              }
            }
          }
        },
